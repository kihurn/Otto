# Otto's keys. Copy this file to   C:\Users\<you>\.otto\.env   (recommended, stays off OneDrive)
# or to  .env  in the Otto folder (works, but OneDrive will sync it). Never share the real file.

# C0RE key for project "otto" (reach: Private) - needed
OTTO_C0RE_KEY=

# Ollama API key, for up-to-date answers via web search - optional
OLLAMA_API_KEY=

# Spotify app Client ID (not a secret, but kept here with the rest) - needed for Spotify control
OTTO_SPOTIFY_CLIENT_ID=
